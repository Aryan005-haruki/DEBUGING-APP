<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/card_elevated"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Severity Color Bar (left edge indicator) -->
        <View
            android:id="@+id/severityBar"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="@color/critical_red"
            android:layout_marginEnd="12dp"/>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Severity Badge -->
            <TextView
                android:id="@+id/tvSeverityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRITICAL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@color/critical_bg"
                android:textColor="@color/critical_red"
                android:layout_marginBottom="4dp"/>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_premium_primary"
                android:layout_marginBottom="2dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_premium_secondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- Arrow -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/text_premium_tertiary"
            android:layout_marginStart="8dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
